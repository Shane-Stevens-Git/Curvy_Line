.venv/
__pycache__/
*.pyc
*.png
*.svg
*.validation.json
newver.json

# wallpaper_engine.py's own runtime state -- generated on first run, not
# part of the source (see DEFAULT_PRESETS/DEFAULT_CONFIG for the shipped
# defaults new installs start from).
wallpaper_config.json
wallpaper_cache/
wallpaper.lock
wallpaper_debug.log
wallpaper_regen.request

# ...except the docs screenshots checked in for index.html -- everything
# else generated by the app (previews, saved exports) stays ignored above.
!screenshots/
!screenshots/*.png

# throwaway helper for manually testing wallpaper_engine.py's WorkerW
# reparenting on a real desktop -- not part of the shipped feature.
wallpaper_live_test.bat
wallpaper_live_test_log.txt
