.venv/
__pycache__/
*.pyc
*.png
*.svg
*.validation.json
newver.json

# wallpaper_engine.py's own runtime state -- generated on first run, not
# part of the source (see DEFAULT_PRESETS/DEFAULT_CONFIG for the shipped
# defaults new installs start from). One instance can now run per monitor
# at once (see MONITOR_ARG), each with its own suffixed lock/debug-log/
# regen-request file (e.g. wallpaper_0.lock, wallpaper_debug_all.log) --
# these globs cover both the original un-suffixed names and every
# per-monitor variant.
wallpaper_config.json
wallpaper_cache/
wallpaper*.lock
wallpaper_debug*.log
wallpaper_regen*.request

# ...except the docs screenshots checked in for index.html -- everything
# else generated by the app (previews, saved exports) stays ignored above.
!screenshots/
!screenshots/*.png

# throwaway helper for manually testing wallpaper_engine.py's WorkerW
# reparenting on a real desktop -- not part of the shipped feature.
wallpaper_live_test.bat
wallpaper_live_test_log.txt

# PyInstaller build output for the packaged screensaver (from
# build_screensaver.bat, or the in-app "Screensaver..." dialog's Build
# button -- see gui.py's _ss_start_build) -- dist/, build/, and the
# generated .spec are all regenerable, and the built screensaver.scr
# itself is a personal, per-machine artifact, not something to check in.
dist/
build/
*.spec
*.scr
screensaver_debug.log
